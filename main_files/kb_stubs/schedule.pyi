from typing import Any, List, Optional

class Slot:
    def __init__(self, start_ns: int, end_ns: int, period_ns: int,
                 stream_id: Optional[int] = ..., port_id: Optional[int] = ...,
                 queue_id: int = ..., index: Optional[int] = ...) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

# Schedule SUBCLASSES list, so append/extend/iteration are real and inherited.
class Schedule(List[Slot]):
    def __init__(self, cycle_ns: int, basetime: Optional[int] = ...,
                 capacity: Optional[int] = ..., iterable: Optional[List[Slot]] = ...) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    cycle_ns: int
    basetime: Optional[int]
    @classmethod
    def from_compact_encoding(cls, compact_encoding: Any, windLengths: Any,
                              stream_intervals: Any, cycle_ns: Optional[int] = ...,
                              basetime: Optional[int] = ..., tt_queue_id: int = ...) -> Schedule: ...
    def to_compact_encoding(self, n_ports: int, n_streams: int) -> Any: ...
    def slots_by_port(self, port_id: int) -> List[Slot]: ...
    def slots_by_stream(self, stream_id: int) -> List[Slot]: ...
